# Categories
msgctxt "#30000"
msgid "Segment Settings"
msgstr "Configurações de segmentos"

msgctxt "#30001"
msgid "Playback & Skip Dialog"
msgstr "Reprodução e diálogo de salto"

msgctxt "#30004"
msgid "Segment Sources"
msgstr "Fontes de segmentos"

msgctxt "#30002"
