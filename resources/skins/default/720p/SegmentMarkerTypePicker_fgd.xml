<?xml version="1.0" encoding="UTF-8"?>
<window>
  <coordinates>
    <system>1</system>
    <posx>0</posx>
    <posy>0</posy>
    <width>1280</width>
    <height>720</height>
  </coordinates>

  <zorder>2</zorder>
  <!-- 9101 is a label (title); labels cannot receive focus — use tiny off-screen button for defaultfocus. -->
  <defaultcontrol>9098</defaultcontrol>

  <animation type="WindowOpen">
    <effect type="fade" start="0" end="100" time="150" />
  </animation>
  <animation type="WindowClose">
    <effect type="fade" start="100" end="0" time="100" />
  </animation>

  <controls>
    <!-- Focusable stub so Kodi opens the window cleanly; SegmentTypePickerDialog.onInit focuses list 9100. -->
    <control type="button" id="9098">
      <left>-9999</left>
      <top>-9999</top>
      <width>10</width>
      <height>10</height>
      <texturefocus colordiffuse="01000000">white.png</texturefocus>
      <texturenofocus colordiffuse="01000000">white.png</texturenofocus>
      <textcolor>00000001</textcolor>
      <focusedcolor>00000001</focusedcolor>
    </control>

    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1280</width>
      <height>720</height>
      <texture border="0">ms_fgd_dim.png</texture>
    </control>

    <control type="group">
      <left>320</left>
      <top>100</top>
      <width>640</width>
      <height>500</height>

      <control type="image">
        <left>0</left>
        <top>0</top>
        <width>640</width>
        <height>500</height>
        <texture border="28">ms_fgd_panel.png</texture>
      </control>

      <!-- Heading stripe (matches Segment Editor button-row darkening) -->


      <control type="label" id="9101">
        <left>30</left>
        <top>10</top>
        <width>580</width>
        <height>40</height>
        <label>Choose segment type</label>
        <font>font30</font>
        <textcolor>$INFO[Window.Property(ms_text)]</textcolor>
        <shadowcolor>$INFO[Window.Property(ms_shadow)]</shadowcolor>
        <shadowoffsetx>2</shadowoffsetx>
        <shadowoffsety>2</shadowoffsety>
      </control>

      <control type="label" id="9102">
        <left>30</left>
        <top>60</top>
        <width>580</width>
        <height>30</height>
        <label>Choose the label for the marked segment.</label>
        <font>font14</font>
        <textcolor>$INFO[Window.Property(ms_text2)]</textcolor>
        <shadowcolor>$INFO[Window.Property(ms_shadow)]</shadowcolor>
        <shadowoffsetx>1</shadowoffsetx>
        <shadowoffsety>1</shadowoffsety>
      </control>

      <control type="list" id="9100">
        <left>30</left>
        <top>102</top>
        <width>580</width>
        <height>312</height>
        <itemlayout width="580" height="44">
          <control type="label">
            <left>16</left>
            <top>6</top>
            <width>548</width>
            <height>32</height>
            <label>$INFO[ListItem.Label]</label>
            <font>font14</font>
            <textcolor>$INFO[Window.Property(ms_text)]</textcolor>
            <shadowcolor>$INFO[Window.Property(ms_shadow)]</shadowcolor>
            <shadowoffsetx>1</shadowoffsetx>
            <shadowoffsety>1</shadowoffsety>
            <aligny>center</aligny>
          </control>
        </itemlayout>
        <focusedlayout width="580" height="44">
          <control type="image">
            <left>0</left>
            <top>0</top>
            <width>580</width>
            <height>44</height>
            <texture border="14">ms_fgd_focus.png</texture>
          </control>
          <control type="label">
            <left>16</left>
            <top>6</top>
            <width>548</width>
            <height>32</height>
            <label>$INFO[ListItem.Label]</label>
            <font>font14</font>
            <textcolor>$INFO[Window.Property(ms_text_focus)]</textcolor>
            <shadowcolor>00000000</shadowcolor>
            <shadowoffsetx>1</shadowoffsetx>
            <shadowoffsety>1</shadowoffsety>
            <aligny>center</aligny>
          </control>
        </focusedlayout>
      </control>

      <!-- Footer stripe -->


      <control type="label" id="9103">
        <left>30</left>
        <top>444</top>
        <width>580</width>
        <height>36</height>
        <label>Enter/OK selects. Back/Esc cancels.</label>
        <font>font12</font>
        <textcolor>$INFO[Window.Property(ms_text3)]</textcolor>
        <shadowcolor>$INFO[Window.Property(ms_shadow)]</shadowcolor>
        <shadowoffsetx>1</shadowoffsetx>
        <shadowoffsety>1</shadowoffsety>
      </control>
    </control>
  </controls>
</window>
