        <texturenofocus border="0" colordiffuse="22FFFFFF">white.png</texturenofocus>
        <textcolor>FFFFFFFF</textcolor>
        <focusedcolor>FFFFFFFF</focusedcolor>
        <shadowcolor>FF000000</shadowcolor>
        <shadowoffsetx>1</shadowoffsetx>
        <shadowoffsety>1</shadowoffsety>
        <align>center</align>
        <aligny>center</aligny>
        <onup>7050</onup>
        <ondown>7092</ondown>
        <onleft>7091</onleft>
        <onright>7092</onright>
      </control>
    </control>
  </controls>
</window>
