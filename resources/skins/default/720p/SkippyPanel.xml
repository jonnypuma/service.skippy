<?xml version="1.0" encoding="utf-8"?>
<!-- Skippy panel: the small windows of the same look as the Customize screens (navy panel, tinted rows with a
     rounded teal highlight, name at the left and value at the right, footer buttons). skippy_panel_ui.py fills it
     and sizes it to what it shows: a list of rows (Statistics, Manage saved auto-skips, Manage autoplay by show,
     the choices in them) or a message, an optional line of small text under the rows, and one to three buttons.
     The numbers below are the full layout (a list with a subtitle); Python moves the panel, the list and the buttons.
     Focus moves natively inside the list; Python sets the links between the list and the buttons. -->
<window>
  <coordinates>
    <system>1</system>
    <posx>0</posx>
    <posy>0</posy>
    <width>1280</width>
    <height>720</height>
  </coordinates>

  <zorder>2</zorder>
  <defaultcontrol>7050</defaultcontrol>

  <controls>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1280</width>
      <height>720</height>
      <texture>white.png</texture>
      <colordiffuse>99000000</colordiffuse>
    </control>

    <control type="group" id="7000">
      <posx>360</posx>
      <posy>41</posy>
      <width>560</width>
      <height>634</height>

      <control type="image" id="7001">
        <left>0</left>
        <top>0</top>
        <width>560</width>
        <height>634</height>
        <texture>white.png</texture>
        <colordiffuse>F2101418</colordiffuse>
      </control>

      <control type="label" id="7002">
        <left>20</left>
        <top>14</top>
        <width>520</width>
        <height>34</height>
        <label></label>
        <font>font12</font>
        <textcolor>FFB0D4E8</textcolor>
        <shadowcolor>FF000000</shadowcolor>
        <shadowoffsetx>1</shadowoffsetx>
        <shadowoffsety>1</shadowoffsety>
        <align>left</align>
        <aligny>center</aligny>
      </control>

      <control type="label" id="7003">
        <left>20</left>
        <top>46</top>
        <width>520</width>
        <height>24</height>
        <label></label>
        <font>font10</font>
        <textcolor>99FFFFFF</textcolor>
        <align>left</align>
        <aligny>center</aligny>
      </control>

      <control type="textbox" id="7004">
        <left>20</left>
        <top>60</top>
        <width>520</width>
        <height>96</height>
        <label></label>
        <font>font12</font>
        <textcolor>FFFFFFFF</textcolor>
        <shadowcolor>FF000000</shadowcolor>
        <shadowoffsetx>1</shadowoffsetx>
        <shadowoffsety>1</shadowoffsety>
        <align>left</align>
        <autoscroll>false</autoscroll>
      </control>

      <control type="list" id="7050">
        <left>20</left>
        <top>76</top>
        <width>520</width>
        <height>484</height>
        <orientation>vertical</orientation>
        <pagecontrol>7060</pagecontrol>
        <scrolltime>150</scrolltime>
        <onup>7050</onup>
        <ondown>7090</ondown>
        <onleft>7050</onleft>
        <onright>7050</onright>
        <itemlayout width="520" height="44">
          <control type="image">
            <left>0</left>
            <top>0</top>
            <width>520</width>
            <height>40</height>
            <texture border="0" colordiffuse="22FFFFFF">white.png</texture>
            <visible>!String.IsEqual(ListItem.Property(header),true)</visible>
          </control>
          <control type="label">
            <left>14</left>
            <top>0</top>
            <width>340</width>
            <height>40</height>
            <label>$INFO[ListItem.Label]</label>
            <font>font12</font>
            <textcolor>FFFFFFFF</textcolor>
            <shadowcolor>FF000000</shadowcolor>
            <shadowoffsetx>1</shadowoffsetx>
            <shadowoffsety>1</shadowoffsety>
            <align>left</align>
            <aligny>center</aligny>
            <visible>!String.IsEmpty(ListItem.Label2) + !String.IsEqual(ListItem.Property(header),true)</visible>
          </control>
          <control type="label">
            <left>14</left>
            <top>0</top>
            <width>492</width>
            <height>40</height>
            <label>$INFO[ListItem.Label]</label>
            <font>font12</font>
            <textcolor>FFFFFFFF</textcolor>
            <shadowcolor>FF000000</shadowcolor>
