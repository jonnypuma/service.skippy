            <align>left</align>
            <aligny>center</aligny>
            <visible>String.IsEmpty(ListItem.Label2) + !String.IsEqual(ListItem.Property(header),true)</visible>
          </control>
          <control type="label">
            <left>364</left>
            <top>0</top>
            <width>142</width>
            <height>40</height>
            <label>$INFO[ListItem.Label2]</label>
            <font>font12</font>
            <textcolor>FFFFFFFF</textcolor>
            <shadowcolor>FF000000</shadowcolor>
            <shadowoffsetx>1</shadowoffsetx>
            <shadowoffsety>1</shadowoffsety>
            <align>right</align>
            <aligny>center</aligny>
          </control>
          <control type="label">
            <left>2</left>
            <top>6</top>
            <width>504</width>
            <height>32</height>
            <label>$INFO[ListItem.Label]</label>
            <font>font12</font>
            <textcolor>FFB0D4E8</textcolor>
            <shadowcolor>FF000000</shadowcolor>
            <shadowoffsetx>1</shadowoffsetx>
            <shadowoffsety>1</shadowoffsety>
            <align>left</align>
            <aligny>center</aligny>
            <visible>String.IsEqual(ListItem.Property(header),true)</visible>
          </control>
        </itemlayout>
        <focusedlayout width="520" height="44">
          <control type="image">
            <left>0</left>
            <top>0</top>
            <width>520</width>
            <height>40</height>
            <texture border="0" colordiffuse="22FFFFFF">white.png</texture>
            <visible>!String.IsEqual(ListItem.Property(header),true)</visible>
          </control>
          <control type="image">
            <left>0</left>
            <top>0</top>
            <width>520</width>
            <height>40</height>
            <texture border="12,12,12,12">button_focus_flat_teal.png</texture>
            <visible>!String.IsEqual(ListItem.Property(header),true) + Control.HasFocus(7050)</visible>
          </control>
          <control type="label">
            <left>14</left>
            <top>0</top>
            <width>340</width>
            <height>40</height>
            <label>$INFO[ListItem.Label]</label>
            <font>font12</font>
            <textcolor>FFFFFFFF</textcolor>
            <shadowcolor>FF000000</shadowcolor>
            <shadowoffsetx>1</shadowoffsetx>
            <shadowoffsety>1</shadowoffsety>
            <align>left</align>
            <aligny>center</aligny>
            <scroll>true</scroll>
            <visible>!String.IsEmpty(ListItem.Label2) + !String.IsEqual(ListItem.Property(header),true)</visible>
          </control>
          <control type="label">
            <left>14</left>
            <top>0</top>
            <width>492</width>
            <height>40</height>
            <label>$INFO[ListItem.Label]</label>
            <font>font12</font>
            <textcolor>FFFFFFFF</textcolor>
            <shadowcolor>FF000000</shadowcolor>
            <shadowoffsetx>1</shadowoffsetx>
            <shadowoffsety>1</shadowoffsety>
            <align>left</align>
            <aligny>center</aligny>
            <scroll>true</scroll>
            <visible>String.IsEmpty(ListItem.Label2) + !String.IsEqual(ListItem.Property(header),true)</visible>
          </control>
          <control type="label">
            <left>364</left>
            <top>0</top>
            <width>142</width>
            <height>40</height>
            <label>$INFO[ListItem.Label2]</label>
            <font>font12</font>
            <textcolor>FFFFFFFF</textcolor>
            <shadowcolor>FF000000</shadowcolor>
            <shadowoffsetx>1</shadowoffsetx>
            <shadowoffsety>1</shadowoffsety>
            <align>right</align>
            <aligny>center</aligny>
          </control>
          <control type="label">
            <left>2</left>
            <top>6</top>
            <width>504</width>
            <height>32</height>
            <label>$INFO[ListItem.Label]</label>
            <font>font12</font>
            <textcolor>FFB0D4E8</textcolor>
            <shadowcolor>FF000000</shadowcolor>
            <shadowoffsetx>1</shadowoffsetx>
            <shadowoffsety>1</shadowoffsety>
            <align>left</align>
            <aligny>center</aligny>
            <visible>String.IsEqual(ListItem.Property(header),true)</visible>
          </control>
        </focusedlayout>
      </control>

      <control type="scrollbar" id="7060">
        <left>546</left>
        <top>76</top>
        <width>6</width>
        <height>484</height>
        <texturesliderbackground colordiffuse="22FFFFFF">white.png</texturesliderbackground>
        <texturesliderbar colordiffuse="66FFFFFF">white.png</texturesliderbar>
        <texturesliderbarfocus colordiffuse="CCFFFFFF">white.png</texturesliderbarfocus>
        <textureslidernib>-</textureslidernib>
        <textureslidernibfocus>-</textureslidernibfocus>
        <orientation>vertical</orientation>
        <showonepage>false</showonepage>
      </control>

      <control type="label" id="7005">
        <left>20</left>
        <top>564</top>
        <width>520</width>
        <height>26</height>
        <label></label>
        <font>font10</font>
        <textcolor>99FFFFFF</textcolor>
        <align>left</align>
        <aligny>center</aligny>
      </control>

      <control type="button" id="7090">
        <left>20</left>
        <top>574</top>
        <width>520</width>
        <height>40</height>
        <label></label>
        <font>font12</font>
        <texturefocus border="12,12,12,12">button_focus_flat_teal.png</texturefocus>
        <texturenofocus border="0" colordiffuse="22FFFFFF">white.png</texturenofocus>
