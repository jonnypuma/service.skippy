      <control type="group" id="7099">
        <posx>0</posx>
        <posy>0</posy>
        <width>1008</width>
        <height>756</height>
        <animation type="Conditional" condition="String.IsEqual(Window.Property(next_ep_zoom),BottomRight)">
          <effect type="zoom" start="125" end="125" time="0" center="978,726" />
